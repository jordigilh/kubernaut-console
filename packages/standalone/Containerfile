# registry.access.redhat.com/ubi9/nodejs-22-minimal:1-1791924375 (linux/amd64, linux/arm64)
FROM registry.access.redhat.com/ubi9/nodejs-22-minimal:1-1791924375@sha256:254080e3c058143c592f708e4ca78691449349fc79f03ee678c717aa4b6222b6 AS build
# Root is limited to build-time dependency installation; the runtime stage is non-root.
USER 0
WORKDIR /build

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/ui-core/package.json packages/ui-core/
COPY packages/standalone/package.json packages/standalone/

RUN npm install -g corepack && corepack enable && corepack prepare pnpm@11.7.0 --activate \
    && pnpm install --frozen-lockfile --filter @kubernaut/standalone...

COPY packages/ui-core/ packages/ui-core/
COPY packages/standalone/ packages/standalone/

RUN pnpm --filter @kubernaut/ui-core build \
    && pnpm --filter @kubernaut/standalone build

# registry.access.redhat.com/ubi9/nginx-126:1-1793251909 (linux/amd64, linux/arm64)
FROM registry.access.redhat.com/ubi9/nginx-126:1-1793251909@sha256:afe4a17857e88905b559b28d61bfa6dd4169a79bde381b4c5dec3cf46608dd70
COPY --from=build /build/packages/standalone/dist /opt/app-root/src

USER 1001
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
