# registry.access.redhat.com/ubi9/nodejs-22-minimal:1-1791924375 (linux/amd64, linux/arm64)
FROM registry.access.redhat.com/ubi9/nodejs-22-minimal:1794243225@sha256:7c28182428503c3e98be630ac8d8c6582c39bb7d4bce34bb862de0cee0f00b25 AS build
# Root is limited to build-time dependency installation; the runtime stage is non-root.
USER 0
WORKDIR /build

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/ui-core/package.json packages/ui-core/
COPY packages/standalone/package.json packages/standalone/

RUN npm install -g corepack && corepack enable && corepack prepare pnpm@11.7.0 --activate \
    && pnpm install --frozen-lockfile --filter @kubernaut/standalone...

COPY packages/ui-core/ packages/ui-core/
COPY packages/standalone/ packages/standalone/

RUN pnpm --filter @kubernaut/ui-core build \
    && pnpm --filter @kubernaut/standalone build

# registry.access.redhat.com/ubi9/nginx-126:1-1793251909 (linux/amd64, linux/arm64)
FROM registry.access.redhat.com/ubi9/nginx-126:1793640017@sha256:ab7d3522224f774b4df6480934c1b8f900714ab42b1faf30d267d3c15c5247b3
# The vendor image predates the curl and glibc advisory fixes. Patch only the
# affected RPMs at image build time; the running container remains USER 1001 below.
USER 0
RUN dnf -y upgrade --refresh \
    curl-minimal \
    libcurl-minimal \
    glibc \
    glibc-common \
    glibc-langpack-en \
    glibc-locale-source \
    glibc-minimal-langpack \
    util-linux \
    util-linux-core \
    libblkid \
    libfdisk \
    libmount \
    libsmartcols \
    libuuid \
    && rpm -q curl-minimal libcurl-minimal glibc glibc-common glibc-langpack-en glibc-locale-source glibc-minimal-langpack util-linux util-linux-core libblkid libfdisk libmount libsmartcols libuuid \
    && dnf clean all
COPY --from=build /build/packages/standalone/dist /opt/app-root/src

USER 1001
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
