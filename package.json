{
  "name": "kubernaut-demo-console",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jordigilh/kubernaut-demo-console.git"
  },
  "homepage": "https://github.com/jordigilh/kubernaut-demo-console",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev --filter @kubernaut/standalone",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test:visual": "npx playwright test e2e/visual.spec.ts",
    "test:visual:update": "npx playwright test e2e/visual.spec.ts --update-snapshots",
    "test:e2e:live": "npx playwright test --config=playwright.live.config.ts",
    "test:e2e:live-v15": "npx playwright test --config=playwright.live-v15.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@patternfly/chatbot": "^6.9.0",
    "@patternfly/react-core": "^6.7.0",
    "@patternfly/react-icons": "^6.7.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@storybook/test": "^8.6.15",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "http-server": "^14.1.1",
    "monaco-editor": "^0.56.0",
    "playwright": "^1.64.1",
    "storybook": "^10.6.2",
    "turbo": "^2.11.8",
    "typescript-eslint": "^8.71.2",
    "wait-on": "^9.5.1"
  }
}
